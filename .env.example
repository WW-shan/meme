# ========== BSC RPC 节点配置 ==========

# BSC RPC节点 (用于Listener监听事件和数据收集)
# 📊 数据收集推荐（按优先级）:
#   1. https://four.rpc.48.club              (FourMeme专用，速度快，推荐！)
#   2. https://rpc.ankr.com/bsc              (Ankr免费层，稳定快速)
#   3. https://bsc.drpc.org                  (dRPC，速度不错)
#   4. https://bsc-dataseed.binance.org      (Binance官方，有限流)
#
# 💰 付费节点（低延迟，无限流，生产环境推荐）:
#   - https://bsc-mainnet.nodereal.io/v1/YOUR_API_KEY
#   - https://YOUR_ENDPOINT.bsc.quiknode.pro/YOUR_KEY/
#   - https://bsc-mainnet.g.alchemy.com/v2/YOUR_API_KEY
#
BSC_WSS_URL=https://four.rpc.48.club

# BSC HTTP RPC (TradeExecutor发送交易，逗号分隔多个节点)
# 如不配置，使用默认节点列表
# 交易推荐: https://bsc-dataseed.binance.org,https://rpc.ankr.com/bsc
BSC_HTTP_RPC=

# FourMeme Contract Address - TokenManager2
FOURMEME_CONTRACT=0x5c952063c7fc8610FFDB798152D69F0B9550762b

# Contract ABI file path
CONTRACT_ABI_PATH=config/TokenManager.lite.abi

# Output Settings
OUTPUT_DIR=data/events
LOG_LEVEL=INFO
LOG_FILE=logs/monitor.log

# Connection Settings
MAX_RETRY_DELAY=60
HEARTBEAT_INTERVAL=60

# Event Filtering
MONITOR_EVENTS=all

# ========== 交易配置 (TRADING CONFIGURATION) ==========

# 钱包私钥 (务必保密! Never commit this!)
PRIVATE_KEY=your_private_key_here

# 交易开关 (Trading switches)
ENABLE_TRADING=false
ENABLE_BACKTEST=true

BASE_GAS_PRICE_GWEI=0.08  # BSC固定gas price
MAX_GAS_PRICE_GWEI=0.1    # 最高不超过0.1 Gwei
GAS_MULTIPLIER=1.0   # 不加价,直接使用固定值